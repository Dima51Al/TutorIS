<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="01_intake" targetNamespace="https://example.org/tutoris/concept" exporter="TutorIS educational model"><bpmn:process id="Process" name="TO-BE: обращение и пробное занятие" isExecutable="false"><bpmn:laneSet id="LaneSet"><bpmn:lane id="Lane_tutor" name="Репетитор"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>offer</bpmn:flowNodeRef><bpmn:flowNodeRef>reply</bpmn:flowNodeRef><bpmn:flowNodeRef>agreed</bpmn:flowNodeRef><bpmn:flowNodeRef>close</bpmn:flowNodeRef><bpmn:flowNodeRef>refused</bpmn:flowNodeRef><bpmn:flowNodeRef>teach</bpmn:flowNodeRef><bpmn:flowNodeRef>continue</bpmn:flowNodeRef><bpmn:flowNodeRef>stop</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_system" name="ИС"><bpmn:flowNodeRef>register</bpmn:flowNodeRef><bpmn:flowNodeRef>trial</bpmn:flowNodeRef><bpmn:flowNodeRef>confirm</bpmn:flowNodeRef><bpmn:flowNodeRef>regular</bpmn:flowNodeRef><bpmn:flowNodeRef>done</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="start" name="Обращение получено"><bpmn:outgoing>f1</bpmn:outgoing><bpmn:messageEventDefinition id="MessageDefinition" /></bpmn:startEvent><bpmn:task id="register" name="Зарегистрировать&#10;обращение"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:task><bpmn:userTask id="offer" name="Предложить время"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:userTask><bpmn:receiveTask id="reply" name="Получить ответ&#10;о времени"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:receiveTask><bpmn:exclusiveGateway id="agreed" name="Время согласовано?"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing><bpmn:outgoing>f7</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="close" name="Закрыть обращение&#10;с причиной"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="refused" name="Отказ"><bpmn:incoming>f6</bpmn:incoming></bpmn:endEvent><bpmn:task id="trial" name="Записать на&#10;пробный урок"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:task><bpmn:sendTask id="confirm" name="Отправить&#10;подтверждение"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:sendTask><bpmn:userTask id="teach" name="Провести пробный;&#10;получить решение"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="continue" name="Продолжает?"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing><bpmn:outgoing>f12</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="stop" name="Работа завершена"><bpmn:incoming>f11</bpmn:incoming></bpmn:endEvent><bpmn:task id="regular" name="Создать регулярный&#10;график"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:task><bpmn:endEvent id="done" name="Ученик подключён"><bpmn:incoming>f13</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="register" /><bpmn:sequenceFlow id="f2" sourceRef="register" targetRef="offer" /><bpmn:sequenceFlow id="f3" sourceRef="offer" targetRef="reply" /><bpmn:sequenceFlow id="f4" sourceRef="reply" targetRef="agreed" /><bpmn:sequenceFlow id="f5" sourceRef="agreed" targetRef="close" name="Нет" /><bpmn:sequenceFlow id="f6" sourceRef="close" targetRef="refused" /><bpmn:sequenceFlow id="f7" sourceRef="agreed" targetRef="trial" name="Да" /><bpmn:sequenceFlow id="f8" sourceRef="trial" targetRef="confirm" /><bpmn:sequenceFlow id="f9" sourceRef="confirm" targetRef="teach" /><bpmn:sequenceFlow id="f10" sourceRef="teach" targetRef="continue" /><bpmn:sequenceFlow id="f11" sourceRef="continue" targetRef="stop" name="Нет" /><bpmn:sequenceFlow id="f12" sourceRef="continue" targetRef="regular" name="Да" /><bpmn:sequenceFlow id="f13" sourceRef="regular" targetRef="done" /></bpmn:process><bpmn:collaboration id="Collaboration"><bpmn:participant id="TutorPool" name="Рабочее пространство одного репетитора" processRef="Process" /><bpmn:participant id="FamilyPool" name="Ученик / родитель" /><bpmn:messageFlow id="Message_0" sourceRef="FamilyPool" targetRef="start" name="Обращение" /><bpmn:messageFlow id="Message_1" sourceRef="offer" targetRef="FamilyPool" name="Предложение" /><bpmn:messageFlow id="Message_2" sourceRef="FamilyPool" targetRef="reply" name="Ответ" /><bpmn:messageFlow id="Message_3" sourceRef="confirm" targetRef="FamilyPool" name="Подтверждение" /></bpmn:collaboration><bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration"><bpmndi:BPMNShape id="DI_TutorPool" bpmnElement="TutorPool" isHorizontal="false"><dc:Bounds x="20" y="70" width="960" height="1250" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Lane_tutor" bpmnElement="Lane_tutor" isHorizontal="false"><dc:Bounds x="50" y="105" width="450" height="1215" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Lane_system" bpmnElement="Lane_system" isHorizontal="false"><dc:Bounds x="500" y="105" width="480" height="1215" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_FamilyPool" bpmnElement="FamilyPool" isHorizontal="false"><dc:Bounds x="1040" y="70" width="170" height="1250" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_start" bpmnElement="start"><dc:Bounds x="255" y="155" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_register" bpmnElement="register"><dc:Bounds x="630" y="205" width="220" height="70" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_offer" bpmnElement="offer"><dc:Bounds x="165" y="320" width="220" height="70" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_reply" bpmnElement="reply"><dc:Bounds x="165" y="440" width="220" height="70" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_agreed" bpmnElement="agreed"><dc:Bounds x="250" y="565" width="50" height="50" /></bpmndi:BPM