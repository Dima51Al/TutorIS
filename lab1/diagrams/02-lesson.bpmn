<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="02_lesson" targetNamespace="https://example.org/tutoris/concept" exporter="TutorIS educational model"><bpmn:process id="Process" name="TO-BE: занятие, прогресс и расчёты" isExecutable="false"><bpmn:laneSet id="LaneSet"><bpmn:lane id="Lane_tutor" name="Репетитор"><bpmn:flowNodeRef>status</bpmn:flowNodeRef><bpmn:flowNodeRef>state</bpmn:flowNodeRef><bpmn:flowNodeRef>move</bpmn:flowNodeRef><bpmn:flowNodeRef>moved</bpmn:flowNodeRef><bpmn:flowNodeRef>teach</bpmn:flowNodeRef><bpmn:flowNodeRef>progress</bpmn:flowNodeRef><bpmn:flowNodeRef>payment</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_system" name="ИС"><bpmn:flowNodeRef>timer</bpmn:flowNodeRef><bpmn:flowNodeRef>remind</bpmn:flowNodeRef><bpmn:flowNodeRef>cancel</bpmn:flowNodeRef><bpmn:flowNodeRef>account</bpmn:flowNodeRef><bpmn:flowNodeRef>balance</bpmn:flowNodeRef><bpmn:flowNodeRef>debt</bpmn:flowNodeRef><bpmn:flowNodeRef>notify</bpmn:flowNodeRef><bpmn:flowNodeRef>nodebt</bpmn:flowNodeRef><bpmn:flowNodeRef>done</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="timer" name="Пора напомнить"><bpmn:outgoing>f1</bpmn:outgoing><bpmn:timerEventDefinition id="TimerDefinition" /></bpmn:startEvent><bpmn:sendTask id="remind" name="Сформировать&#10;напоминание"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:sendTask><bpmn:userTask id="status" name="Уточнить статус&#10;занятия"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="state" name="Статус?"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing><bpmn:outgoing>f6</bpmn:outgoing><bpmn:outgoing>f7</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="move" name="Задать&#10;новое время"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="moved" name="Новое время задано"><bpmn:incoming>f5</bpmn:incoming></bpmn:endEvent><bpmn:task id="cancel" name="Применить правило&#10;отмены"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:task><bpmn:userTask id="teach" name="Провести урок"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="progress" name="Записать тему,&#10;ДЗ и результат"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:userTask><bpmn:task id="account" name="Обновить списание&#10;без дублирования"><bpmn:incoming>f9</bpmn:incoming><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:task><bpmn:userTask id="payment" name="Подтвердить&#10;поступления / аванс"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:userTask><bpmn:task id="balance" name="Пересчитать баланс"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="debt" name="Есть долг?"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing><bpmn:outgoing>f15</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:sendTask id="notify" name="Отправить&#10;напоминание о долге"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing></bpmn:sendTask><bpmn:endEvent id="nodebt" name="Цикл завершён"><bpmn:incoming>f15</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="done" name="Долг зафиксирован"><bpmn:incoming>f16</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="f1" sourceRef="timer" targetRef="remind" /><bpmn:sequenceFlow id="f2" sourceRef="remind" targetRef="status" /><bpmn:sequenceFlow id="f3" sourceRef="status" targetRef="state" /><bpmn:sequenceFlow id="f4" sourceRef="state" targetRef="move" name="Перенос" /><bpmn:sequenceFlow id="f5" sourceRef="move" targetRef="moved" /><bpmn:sequenceFlow id="f6" sourceRef="state" targetRef="cancel" name="Отмена" /><bpmn:sequenceFlow id="